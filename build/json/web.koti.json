        0.4,
        0.8,
        1
      ],
      "low": 0.25,
      "high": 1
    },
    "spinner": {
      "duration": 0.9
    },
    "panel": {
      "duration": 0.3,
      "reducedDuration": 0.2,
      "dragReturnDuration": 0.2
    },
    "toast": {
      "enterDuration": 0.25,
      "curve": "easeOut",
      "slide": 16,
      "reducedDuration": 0.2,
      "visible": {
        "withoutAction": 4,
        "withAction": 6,
        "voiceOver": 10
      }
    },
