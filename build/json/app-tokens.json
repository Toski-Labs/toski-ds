  "typography": {
    "family": "Outfit",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "styles": {
      "largeTitle": {
        "size": 28,
        "weight": 600,
        "tracking": -0.01
      },
      "title": {
        "size": 22,
        "weight": 600
      },
      "headline": {
        "size": 17,
        "weight": 600
      },
      "body": {
        "size": 16,
        "weight": 400
      },
      "callout": {
        "size": 15,
        "weight": 400
      },
      "subheadline": {
        "size": 14,
        "weight": 400
      },
      "footnote": {
        "size": 13,
        "weight": 400
      },
      "sectionLabel": {
        "size": 13,
        "weight": 600,
        "tracking": 0.06,
        "uppercase": true
      },
      "caption": {
        "size": 12,
        "weight": 400
      },
      "tabLabel": {
        "size": 11,
        "weight": 500
      },
      "screenTitle": {
        "size": 27,
        "weight": 700,
        "tracking": -0.01,
        "lineHeight": 1.15,
        "align": "leading"
      },
      "sheetTitle": {
        "size": 22,
        "weight": 700,
        "lineHeight": 1.15
      },
      "nameLarge": {
        "size": 17,
        "weight": 600
      },
      "name": {
        "size": 16,
        "weight": 600
      },
      "support": {
        "size": 15,
        "weight": 400
      },
      "supportSmall": {
        "size": 14,
        "weight": 400
      },
      "label": {
        "size": 13,
        "weight": 600,
        "tracking": 0.06,
        "uppercase": true
      }
    }
  },
  "radius": {
    "$description": "Pílula = Capsule e círculo (50%) = Circle: não têm token. appIcon(side:) = side × radius / side de referência.",
    "pdfPage": 4,
    "inset": 14,
    "appIcon": {
      "radius": 22,
      "side": 96
    },
    "surface": 22
  },
  "shadow": {
    "$description": "Valores do box-shadow do canvas (x = 0). Em SwiftUI o radius é blur / 2. Iguais no claro e no escuro.",
    "knob": {
      "y": 1,
      "blur": 3,
      "color": "#000000",
      "opacity": 0.25
    },
    "raised": {
      "y": 1,
      "blur": 3,
      "color": "#231B17",
      "opacity": 0.15
    },
    "floating": {
      "y": 8,
      "blur": 24,
      "color": "#231B17",
      "opacity": 0.22
    },
    "sheet": {
      "y": -8,
      "blur": 32,
      "color": "#231B17",
      "opacity": 0.18
    },
    "glass": {
      "light": {
        "y": 1,
        "blur": 3,
        "color": "#231B17",
        "opacity": 0.15,
        "ring": {
          "width": 0.5,
          "color": "#231B17",
          "opacity": 0.06
        }
      },
      "dark": {
        "y": 1,
        "blur": 3,
        "color": "#000000",
        "opacity": 0.35,
        "ring": {
          "width": 0.5,
          "color": "#F7F1E8",
          "opacity": 0.06
        }
      }
    },
    "glassNeve": {
      "light": {
        "y": 1,
        "blur": 3,
        "color": "#000000",
        "opacity": 0.08,
        "ring": {
          "width": 0.5,
          "color": "#000000",
          "opacity": 0.06
        }
      },
      "dark": {
        "y": 1,
        "blur": 3,
        "color": "#000000",
        "opacity": 0.4,
        "ring": {
          "width": 0.5,
          "color": "#FFFFFF",
          "opacity": 0.06
        }
      }
    }
  },
  "spacing": {
    "screenMargin": 24,
    "block": 14
  },
  "size": {
    "minTouchTarget": 44,
    "primaryButtonHeight": 54,
    "avatarSmall": 24,
    "avatar": 48,
    "avatarLarge": 76,
    "rowHome": 98,
    "rowList": 76,
    "rowForm": 52,
    "rowDetail": 44,
    "glassButton": 54,
    "roundButton": 44,
