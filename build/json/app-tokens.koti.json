  "typography": {
    "family": "Outfit",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "styles": {
      "largeTitle": {
        "size": 28,
        "weight": 600,
        "tracking": -0.01
      },
      "title": {
        "size": 22,
        "weight": 600
      },
      "headline": {
        "size": 17,
        "weight": 600
      },
      "body": {
        "size": 16,
        "weight": 400
      },
      "callout": {
        "size": 15,
        "weight": 400
      },
      "subheadline": {
        "size": 14,
        "weight": 400
      },
      "footnote": {
        "size": 13,
        "weight": 400
      },
      "sectionLabel": {
        "size": 13,
        "weight": 600,
        "tracking": 0.06,
        "uppercase": true
      },
      "caption": {
        "size": 12,
        "weight": 400
      },
      "tabLabel": {
        "size": 11,
        "weight": 500
      }
    }
  },
  "radius": {
    "$description": "Pílula = Capsule e círculo (50%) = Circle: não têm token. sheet arredonda só os cantos de cima. appIcon(side:) = side × radius / side de referência.",
    "checkbox": 7,
    "swatch": 3,
    "pdfPage": 4,
    "small": 9,
    "iconBox": 12,
    "buttonSmall": 12,
    "segmentTrack": 12,
    "input": 14,
    "button": 14,
    "tile": 16,
    "card": 18,
    "notification": 22,
    "sheet": 28,
    "appIcon": {
      "radius": 22,
      "side": 96
    }
  },
  "shadow": {
    "$description": "Valores do box-shadow do canvas (x = 0). Em SwiftUI o radius é blur / 2. Iguais no claro e no escuro.",
    "knob": {
      "y": 1,
      "blur": 3,
      "color": "#000000",
      "opacity": 0.25
    },
    "raised": {
      "y": 1,
      "blur": 3,
      "color": "#231B17",
      "opacity": 0.15
    },
    "floating": {
      "y": 8,
      "blur": 24,
      "color": "#231B17",
      "opacity": 0.22
    },
    "sheet": {
      "y": -8,
      "blur": 32,
      "color": "#231B17",
      "opacity": 0.18
    }
  },
  "spacing": {
    "xs": 4,
    "s": 8,
    "m": 12,
    "l": 16,
    "xl": 20,
    "xxl": 24,
    "screenPadding": 20
  },
  "size": {
    "minTouchTarget": 44,
    "primaryButtonHeight": 54,
    "avatarSmall": 24,
    "avatar": 48,
    "avatarLarge": 76
  },
  "pdf": {
    "rule": "O PDF usa sempre os valores claros dos tokens, nunca o tema do aparelho."
  },
  "appleButton": {
    "rule": "Botão \"Continuar com a Apple\" segue a diretriz da Apple e fica fora da paleta: claro = fundo #000000, texto #FFFFFF; escuro = fundo #FFFFFF, texto #000000."
  },
